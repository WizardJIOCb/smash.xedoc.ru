[Unit]
Description=Los Firewall cooperative room relay
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/los-firewall/server/coop
ExecStart=/usr/bin/node relay.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8791
Environment=COOP_ORIGINS=https://smash.xedoc.ru
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
